});
document.addEventListener('keydown', function(e){
  if (e.key === 'Escape'){ closeAnalystModal(); closeBreakdownModal(); closeHelpModal(); }
});

function trendClass(cur, prev){
  if (cur === null || cur === undefined || prev === null || prev === undefined) return '';
  if (cur > prev) return ' trend-up';
  if (cur < prev) return ' trend-down';
  return '';
}

/* Pulls this analyst's stats out of every saved upload (current view + history),
   de-duplicated by upload id, oldest first. */
function collectAnalystHistory(name){
  var seen = {};
  var pool = [];
  getHistory().forEach(function(entry){ if (!seen[entry.histId]) { seen[entry.histId] = 1; pool.push(entry); } });
  try{
    var cur = JSON.parse(localStorage.getItem(DATA_KEY) || 'null');
    if (cur && !seen[cur.histId]) pool.push(cur);
  }catch(e){}

  pool.sort(function(a,b){
    var da = a.reportDate ? new Date(a.reportDate).getTime() : (a.loadedAt||0);
    var db = b.reportDate ? new Date(b.reportDate).getTime() : (b.loadedAt||0);
    return da - db;
  });

  var rows = [];
  pool.forEach(function(entry){
    var match = (entry.analysts || []).find(function(a){ return norm(a.name) === norm(name); });
    if (match){
      rows.push({
        date: entry.reportDate || null,
        approvalPct: match.approvalPct, pullPct: match.pullPct,
        booked: match.booked, bookedApps: match.bookedApps,
        approved: match.approved, reviewed: match.reviewed
      });
    }
  });
  return rows;
}

function openAnalystModal(name){
  document.getElementById('analyst-modal-name').textContent = name;
  document.getElementById('analyst-modal-overlay').classList.add('open');

  var rows = collectAnalystHistory(name);
  var tableEl = document.getElementById('analyst-modal-table');
  var sparkWrapEl = document.getElementById('analyst-modal-spark-wrap');
  var emptyEl = document.getElementById('analyst-modal-empty');

  if (!rows.length){
    tableEl.style.display = 'none';
    sparkWrapEl.style.display = 'none';
    emptyEl.style.display = 'block';
    return;
  }
  tableEl.style.display = '';
  sparkWrapEl.style.display = '';
  emptyEl.style.display = 'none';

  var maxBooked = Math.max.apply(null, rows.map(function(r){ return r.booked || 0; }).concat([1]));
  var sparkHtml = '';
  rows.forEach(function(r){
    var h = maxBooked ? Math.max(4, Math.round((r.booked||0)/maxBooked*60)) : 4;
    sparkHtml += '<div class="spark-col"><div class="spark-bar' + ((r.booked||0)===0?' zero':'') + '" style="height:' + h + 'px" title="' + fmtMoney(r.booked) + '"></div><div class="spark-date">' + (r.date ? fmtDateShort(r.date) : '—') + '</div></div>';
  });
  document.getElementById('analyst-modal-spark').innerHTML = sparkHtml;

  var tableHtml = '';
  for (var i = rows.length - 1; i >= 0; i--){
    var r = rows[i], prev = rows[i-1];
    tableHtml += '<tr>' +
      '<td class="lb-name">' + (r.date ? fmtDateShort(r.date) : '—') + '</td>' +
      '<td class="num' + trendClass(r.approvalPct, prev && prev.approvalPct) + '">' + fmtPct(r.approvalPct) + '</td>' +
      '<td class="num' + trendClass(r.pullPct, prev && prev.pullPct) + '">' + fmtPct(r.pullPct) + '</td>' +
      '<td class="num' + trendClass(r.booked, prev && prev.booked) + '">' + fmtMoney(r.booked) + '</td>' +
      '<td class="num">' + fmtInt(r.bookedApps) + '</td>' +
      '<td class="num">' + fmtMoney(r.approved) + '</td>' +
      '<td class="num">' + fmtMoney(r.reviewed) + '</td>' +
      '</tr>';
  }
  document.getElementById('analyst-modal-rows').innerHTML = tableHtml;
}

function closeAnalystModal(){
  document.getElementById('analyst-modal-overlay').classList.remove('open');
}

/* ============================================================
   MARKET / QUARTER BREAKDOWN MODAL — click either YTD stat card
   (Pull Through Rate or Total Booked) to see it broken out by
   market and quarter, straight from the "All Quarters" tab.
   ============================================================ */
var BREAKDOWN_COLORS = ['#00D4FF','#00FF88','#FFD166','#FF6B6B','#C77DFF','#9AA5B1'];

function getCurrentData(){
  try{ return JSON.parse(localStorage.getItem(DATA_KEY) || 'null'); }catch(e){ return null; }
}

function openBreakdownModal(metric){
  var overlay = document.getElementById('breakdown-modal-overlay');
  overlay.classList.add('open');
  document.getElementById('breakdown-modal-title').textContent = metric === 'booked' ? 'Total Booked' : 'Pull Through Rate';

  var cur = getCurrentData();
  var aq = cur && cur.allQuarters;
  var chartEl = document.getElementById('breakdown-chart');
  var legendEl = document.getElementById('breakdown-legend');
  var tableEl = document.getElementById('breakdown-table');
  var emptyEl = document.getElementById('breakdown-empty');

  var quartersWithRegions = (aq && aq.quarters) ? aq.quarters.filter(function(q){ return q.regions; }) : [];
  if (!quartersWithRegions.length){
    chartEl.style.display = 'none';
    legendEl.style.display = 'none';
    tableEl.style.display = 'none';
    emptyEl.style.display = 'block';
    return;
  }
  chartEl.style.display = 'flex';
  legendEl.style.display = 'flex';
  tableEl.style.display = 'table';
  emptyEl.style.display = 'none';

  var regions = quartersWithRegions[0].regions;

  var legendHtml = '';
  regions.forEach(function(r, idx){
    legendHtml += '<span class="legend-item"><span class="legend-swatch" style="background:' + BREAKDOWN_COLORS[idx % BREAKDOWN_COLORS.length] + '"></span>' + escapeHtml(r) + '</span>';
  });
  legendEl.innerHTML = legendHtml;

  function valueFor(q, regionIdx){
    var arr = metric === 'booked' ? q.bookedDollar : q.pullThroughPct;
    return (arr && arr[regionIdx] !== undefined) ? arr[regionIdx] : null;
  }

  var maxVal = 0;
  quartersWithRegions.forEach(function(q){
    regions.forEach(function(r, idx){
      var v = valueFor(q, idx);
      if (v !== null && v > maxVal) maxVal = v;
    });
  });
  if (!maxVal) maxVal = 1;

  var chartHtml = '';
  quartersWithRegions.forEach(function(q){
    var barsHtml = '';
    regions.forEach(function(r, idx){
      var v = valueFor(q, idx);
      var h = v !== null ? Math.max(2, Math.round((v / maxVal) * 180)) : 2;
      var label = v !== null ? (metric === 'booked' ? fmtMoneyShort(v) : fmtPct(v,1)) : 'No data';
      barsHtml += '<div class="bq-bar" style="height:' + h + 'px;background:' + BREAKDOWN_COLORS[idx % BREAKDOWN_COLORS.length] + '" title="' + escapeHtml(r) + ': ' + label + '"></div>';
    });
    chartHtml += '<div class="bq-group"><div class="bq-bars">' + barsHtml + '</div><div class="bq-group-label">' + q.label + '</div></div>';
  });
  chartEl.innerHTML = chartHtml;

  var theadHtml = '<thead><tr><th>Market</th>';
  quartersWithRegions.forEach(function(q){ theadHtml += '<th class="num">' + q.label + '</th>'; });
  theadHtml += '</tr></thead>';

  var bodyHtml = '<tbody>';
  regions.forEach(function(r, idx){
    bodyHtml += '<tr><td class="lb-name">' + escapeHtml(r) + '</td>';
    quartersWithRegions.forEach(function(q){
      var v = valueFor(q, idx);
      bodyHtml += '<td class="num">' + (v !== null ? (metric === 'booked' ? fmtMoney(v) : fmtPct(v,1)) : '—') + '</td>';
    });
    bodyHtml += '</tr>';
  });
  bodyHtml += '<tr class="sb-total-row"><td class="lb-name">TOTAL</td>';
  quartersWithRegions.forEach(function(q){
    var arr = metric === 'booked' ? q.bookedDollar : q.pullThroughPct;
    var v = (arr && arr[6] !== undefined) ? arr[6] : null;
    bodyHtml += '<td class="num">' + (v !== null ? (metric === 'booked' ? fmtMoney(v) : fmtPct(v,1)) : '—') + '</td>';
  });
  bodyHtml += '</tr></tbody>';

  tableEl.innerHTML = theadHtml + bodyHtml;
}

function closeBreakdownModal(){
  document.getElementById('breakdown-modal-overlay').classList.remove('open');
}

function openHelpModal(){
  document.getElementById('help-modal-overlay').classList.add('open');
  document.querySelectorAll('.stp-drop-menu.open').forEach(function(m){ m.classList.remove('open'); });
}
function closeHelpModal(){
  document.getElementById('help-modal-overlay').classList.remove('open');
}
</script>
</body>
</html>
