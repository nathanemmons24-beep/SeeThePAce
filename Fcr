<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title>2nd Look Scoreboard | See The Pace</title>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='20' fill='%230A0118'/%3E%3Cpolygon points='58,10 25,58 48,58 42,90 75,42 52,42 60,10' fill='%2300D4FF'/%3E%3C/svg%3E"/>
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Exo+2:wght@300;400;600;700&display=swap" rel="stylesheet"/>
<style>
  *{box-sizing:border-box}
  body{margin:0;background:#05070A;color:#E7EBF0;font-family:"Exo 2",sans-serif;min-height:100vh;overflow-x:hidden}
  body::before{content:"";position:fixed;inset:0;z-index:0;pointer-events:none;background-image:linear-gradient(rgba(255,255,255,0.025) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,0.025) 1px,transparent 1px);background-size:60px 60px}
  @keyframes shimmer{0%{background-position:-200% center}100%{background-position:200% center}}
  @keyframes stp-fadein{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}
  @keyframes stp-ring{0%{transform:rotate(0deg)}100%{transform:rotate(360deg)}}
  @keyframes livePulse{0%,100%{opacity:1;box-shadow:0 0 0 0 rgba(255,70,70,0.6)}50%{opacity:.55;box-shadow:0 0 0 5px rgba(255,70,70,0)}}
  ::-webkit-scrollbar{width:4px}::-webkit-scrollbar-track{background:transparent}::-webkit-scrollbar-thumb{background:rgba(255,255,255,0.08);border-radius:2px}

  /* ── LOADING / PASSWORD SPLASH (separate from main site) ── */
  #loading-overlay{position:fixed;inset:0;z-index:99999;background:#020B18;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:24px;transition:opacity 0.6s ease}
  #loading-overlay.fade-out{opacity:0;pointer-events:none}
  .stp-title{font-family:"Orbitron",monospace;font-weight:900;font-size:clamp(26px,5.5vw,44px);letter-spacing:6px;background:linear-gradient(135deg,#00D4FF,#00FF88,#FFD700);background-size:200% auto;-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;animation:shimmer 4s linear infinite}
  .stp-ring{width:56px;height:56px;border:3px solid rgba(0,212,255,0.15);border-top:3px solid #00D4FF;border-radius:50%;animation:stp-ring 1s linear infinite;display:none}
  .stp-dots::after{content:"";animation:stp-dots 1.5s steps(1) infinite}
  @keyframes stp-dots{0%{content:""}33%{content:"."}66%{content:".."}100%{content:"..."}}
  #stp-loading-text{display:none;font-family:Orbitron,monospace;font-size:13px;letter-spacing:3px;color:#475569}
  #stp-enter-btn{font-family:Orbitron,monospace;font-size:17px;font-weight:700;letter-spacing:6px;color:#00D4FF;background:transparent;border:1.5px solid rgba(0,212,255,0.5);border-radius:40px;padding:14px 48px;cursor:pointer;transition:all 0.3s;animation:stp-fadein 0.8s ease both;margin-top:8px}
  #stp-enter-btn:hover{background:rgba(0,212,255,0.1);box-shadow:0 0 20px rgba(0,212,255,0.3)}
  #stp-pw-input{background:rgba(255,255,255,0.04);border:1px solid rgba(0,212,255,0.25);border-radius:10px;padding:12px 24px;color:#fff;font-family:Orbitron,monospace;font-size:16px;letter-spacing:4px;width:220px;text-align:center;outline:none}
  #stp-pw-err{color:#FF4444;font-family:Orbitron,monospace;font-size:11px;letter-spacing:2px;display:none}
  #stp-pw-submit{font-family:Orbitron,monospace;font-size:15px;font-weight:700;letter-spacing:4px;color:#00D4FF;background:transparent;border:1.5px solid rgba(0,212,255,0.5);border-radius:40px;padding:10px 36px;cursor:pointer;transition:all 0.3s}
  #stp-pw-submit:hover{background:rgba(0,212,255,0.1)}

  /* ── NAV (SeeThePace branding, same look as main site) ── */
  #stp-nav{position:fixed;top:0;left:0;right:0;z-index:9999;display:none;align-items:center;justify-content:space-between;padding:0 24px;height:48px;background:linear-gradient(135deg,#040810 0%,#080E1A 50%,#040810 100%);border-bottom:2px solid rgba(0,200,255,0.25);box-shadow:0 2px 20px rgba(0,200,255,0.1);font-family:'Orbitron',monospace}
  #stp-nav.stp-nav-visible{display:flex}
  #stp-brand{display:flex;align-items:center;gap:8px;text-decoration:none;flex-shrink:0;cursor:pointer}
  #stp-bolt{font-size:22px;filter:drop-shadow(0 0 8px #00C8FF)}
  #stp-wordmark{font-family:'Orbitron',monospace;font-weight:900;font-size:15px;letter-spacing:3px;background:linear-gradient(90deg,#00C8FF,#E0F8FF,#00C8FF);background-size:200% auto;-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
  #stp-sub-wordmark{font-family:'Orbitron',monospace;font-size:11px;letter-spacing:2px;color:rgba(255,255,255,0.35);border-left:1px solid rgba(255,255,255,0.15);padding-left:10px;margin-left:2px}
  #stp-links{display:flex;align-items:center;gap:4px}
  .stp-link{color:rgba(255,255,255,0.65);font-family:'Orbitron',monospace;font-size:12px;font-weight:700;letter-spacing:1.5px;text-decoration:none;padding:6px 14px;border-radius:8px;border:none;background:transparent;cursor:pointer;transition:all 0.15s;white-space:nowrap}
  .stp-link:hover{color:#00C8FF;background:rgba(0,200,255,0.08)}
  .stp-dropdown{position:relative}
  .stp-drop-menu{display:none;position:absolute;top:calc(100% + 2px);right:0;background:#06091A;border:1px solid rgba(0,200,255,0.2);border-radius:12px;padding:8px;min-width:210px;box-shadow:0 8px 32px rgba(0,0,0,0.6);z-index:9600}
  .stp-drop-menu.open{display:block}
  .stp-drop-label{font-family:'Orbitron',monospace;font-size:10px;letter-spacing:2px;color:rgba(0,200,255,0.5);padding:4px 10px 2px;text-transform:uppercase}
  .stp-drop-divider{height:1px;background:rgba(0,200,255,0.1);margin:6px 4px}
  .stp-drop-item{display:block;padding:8px 12px;border-radius:8px;font-size:14px;color:rgba(255,255,255,0.75);text-decoration:none;cursor:pointer;transition:all 0.12s;font-family:'Inter',sans-serif;font-weight:500;white-space:nowrap;background:transparent;border:none;width:100%;text-align:left}
  .stp-drop-item:hover{background:rgba(0,200,255,0.08);color:#00C8FF}

  /* ── HISTORY MENU ── */
  .hist-item{display:flex;align-items:center;gap:8px;padding:8px 10px;border-radius:8px;cursor:pointer;transition:all 0.12s;background:transparent;border:none;width:100%;text-align:left;font-family:'Inter',sans-serif}
  .hist-item:hover{background:rgba(0,200,255,0.08)}
  .hist-item.active{background:rgba(0,200,255,0.1);border-left:2px solid #00C8FF;padding-left:8px}
  .hist-item-check{width:16px;flex-shrink:0;color:#00C8FF;font-size:13px}
  .hist-item-body{flex:1;min-width:0}
  .hist-item-date{font-size:14px;color:#E2E8F0;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .hist-item-meta{font-size:11.5px;color:rgba(255,255,255,0.4);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:1px}
  .hist-empty{padding:10px 10px;font-size:13.5px;color:rgba(255,255,255,0.35);font-style:italic}

  /* ── LIGHT MODE — full theme, including the arena board itself ── */
  body.light-mode{background:#EEF1F5!important}
  body.light-mode #stp-nav{background:linear-gradient(135deg,#F8FAFC,#EFF6FF);border-color:rgba(0,200,255,0.3)}
  body.light-mode .stp-link{color:rgba(0,0,0,0.6)}
  body.light-mode .stp-drop-menu{background:#fff;border-color:rgba(0,0,0,0.12)}
  body.light-mode .stp-drop-item{color:#1E293B}
  body.light-mode .hist-item:hover{background:rgba(0,150,220,0.08)}
  body.light-mode .hist-item-date{color:#0F172A}
  body.light-mode .hist-item-meta{color:rgba(15,23,42,0.45)}
  body.light-mode .hist-empty{color:rgba(15,23,42,0.35)}

  body.light-mode #sb-empty{border-color:rgba(0,0,0,0.15);background:rgba(0,0,0,0.02)}
  body.light-mode #sb-empty h2{color:#0F172A}
  body.light-mode #sb-empty p{color:#475569}
  body.light-mode .sb-upload-btn{background:#0F172A;border-color:#0F172A;color:#fff}
  body.light-mode #sb-msg-line1{color:#B45309}
  body.light-mode #sb-msg-line2{color:#334155}
  body.light-mode #sb-file-meta{color:#0F172A}

  body.light-mode #arena-board{
    background:radial-gradient(circle at 15% 0%,rgba(0,0,0,0.03),transparent 45%),linear-gradient(150deg,#FFFFFF 0%,#F3F5F8 45%,#ECEFF3 100%);
    border-color:rgba(0,0,0,0.1);box-shadow:0 30px 60px rgba(15,23,42,0.12), inset 0 0 60px rgba(0,0,0,0.01);
  }
  body.light-mode .hud-corner{border-color:rgba(15,23,42,0.28)!important}
  body.light-mode #arena-topbar{border-bottom-color:rgba(0,0,0,0.08)}
  body.light-mode .arena-pill{background:rgba(0,0,0,0.03);border-color:rgba(0,0,0,0.12);color:#64748B}
  body.light-mode .arena-pill b{color:#0F172A}
  body.light-mode #arena-title{color:#0F172A}
  body.light-mode #arena-subtitle{color:#94A3B8}
  body.light-mode .hud-panel{background:rgba(0,0,0,0.02);border-color:rgba(0,0,0,0.09)}
  body.light-mode .hud-panel-head{border-bottom-color:rgba(0,0,0,0.07)}
  body.light-mode .hud-panel-title{color:#0F172A}
  body.light-mode .hud-panel-tag{color:#94A3B8}
  body.light-mode .gauge::before{background:#F3F5F8}
  body.light-mode .gauge-num{color:#0F172A}
  body.light-mode .gauge-lbl{color:#64748B}
  body.light-mode .metric-top{color:#64748B}
  body.light-mode .metric-top b{color:#0F172A}
  body.light-mode .metric-bar{background:rgba(0,0,0,0.08)}
  body.light-mode .metric-bar-fill{background:linear-gradient(90deg,#475569,#0F172A)}
  body.light-mode .core-stat-lbl{color:#94A3B8}
  body.light-mode .core-stat-val{color:#0F172A}
  body.light-mode .minibars i{background:linear-gradient(180deg,#0F172A,#475569)}
  body.light-mode .momentum-svg polyline{stroke:#0F172A!important}
  body.light-mode .champion-ring{border-color:rgba(0,0,0,0.16)}
  body.light-mode .champion-ring::before{border-color:rgba(0,0,0,0.08)}
  body.light-mode .champion-label,body.light-mode .champion-sub{color:#94A3B8}
  body.light-mode .champion-name,body.light-mode .champion-total{color:#0F172A}
  body.light-mode .podium-tab{background:rgba(0,0,0,0.03);border-color:rgba(0,0,0,0.12);color:#0F172A}
  body.light-mode .tier-row{border-bottom-color:rgba(0,0,0,0.06)}
  body.light-mode .tier-name{color:#94A3B8}
  body.light-mode .tier-analyst,body.light-mode .tier-amount{color:#0F172A}
  body.light-mode .tier-dots i{background:rgba(0,0,0,0.1)}
  body.light-mode .tier-dots i.on{background:#0F172A}
  body.light-mode #panel-rewards .hud-panel-foot{border-top-color:rgba(0,0,0,0.07)}
  body.light-mode #panel-rewards .hud-panel-foot .fv{color:#0F172A}
  body.light-mode #panel-rewards .hud-panel-foot .fl{color:#94A3B8}
  body.light-mode .snap-row{border-bottom-color:rgba(0,0,0,0.05)}
  body.light-mode .snap-rank{background:rgba(0,0,0,0.04);border-color:rgba(0,0,0,0.14);color:#0F172A}
  body.light-mode .snap-name,body.light-mode .snap-amount{color:#0F172A}
  body.light-mode .snap-sub{color:#94A3B8}
  body.light-mode .snap-bar{background:rgba(0,0,0,0.08)}
  body.light-mode .snap-bar-fill{background:linear-gradient(90deg,#475569,#0F172A)}
  body.light-mode .lb-table thead th{color:#94A3B8}
  body.light-mode .lb-table tbody td{color:#334155;border-bottom-color:rgba(0,0,0,0.05)}
  body.light-mode .lb-table td.num,body.light-mode .lb-name{color:#0F172A}
  body.light-mode .lb-rank{color:#94A3B8}
  body.light-mode .lb-power-bar{background:rgba(0,0,0,0.08)}
  body.light-mode .lb-power-fill{background:linear-gradient(90deg,#475569,#0F172A)}
  body.light-mode .lb-state{background:rgba(0,0,0,0.06);color:#475569}
  body.light-mode .lb-state.elite{background:rgba(180,83,9,0.12);color:#B45309}
  body.light-mode .lb-state.hold{background:rgba(0,0,0,0.03);color:#94A3B8}
  body.light-mode .log-row{border-bottom-color:rgba(0,0,0,0.05)}
  body.light-mode .log-time{color:#94A3B8}
  body.light-mode .log-label{color:#334155}
  body.light-mode .log-val{color:#0F172A}
  body.light-mode #log-total{border-top-color:rgba(0,0,0,0.08)}
  body.light-mode #log-total .lt-lbl{color:#94A3B8}
  body.light-mode #log-total .lt-val{color:#0F172A}
  body.light-mode #arena-footer{border-top-color:rgba(0,0,0,0.08)}
  body.light-mode .arena-foot-item{color:#94A3B8}
  body.light-mode .arena-foot-item b{color:#334155}

  /* ============================================================
     ARENA RANK BOARD — main scoreboard shell
     ============================================================ */
  #app{position:relative;z-index:1;max-width:1320px;margin:0 auto;padding:24px 16px 60px;padding-top:86px;display:none}
  #app.visible{display:block}

  #sb-empty{max-width:520px;margin:100px auto 0;text-align:center;padding:40px 24px;border:2px dashed rgba(255,255,255,0.18);border-radius:18px;background:rgba(255,255,255,0.02)}
  #sb-empty.dragover{border-color:#00D4FF;background:rgba(0,212,255,0.08)}
  #sb-empty h2{font-family:Orbitron,monospace;font-size:19px;letter-spacing:2px;color:#fff;margin:0 0 10px}
  #sb-empty p{font-size:15px;color:#8B96A5;margin:0 0 20px;line-height:1.6}
  .sb-upload-btn{font-family:Orbitron,monospace;font-size:14px;font-weight:700;letter-spacing:2px;color:#0b0d10;background:#fff;border:1.5px solid #fff;border-radius:40px;padding:12px 32px;cursor:pointer;transition:all 0.2s}
  .sb-upload-btn:hover{opacity:.85}
  #sb-file-error{color:#FF6B6B;font-size:14px;margin-top:14px;display:none}

  #arena-board{position:relative;background:
      radial-gradient(circle at 15% 0%,rgba(255,255,255,0.05),transparent 45%),
      linear-gradient(150deg,#14171C 0%,#0B0D11 45%,#0A0C10 100%);
    border:1px solid rgba(255,255,255,0.12);border-radius:26px;padding:26px 26px 18px;
    box-shadow:0 30px 60px rgba(0,0,0,0.55), inset 0 0 60px rgba(255,255,255,0.015);
  }
  .hud-corner{position:absolute;width:16px;height:16px;pointer-events:none;z-index:2}
  .hud-corner.tl{top:8px;left:8px;border-top:2px solid rgba(255,255,255,0.32);border-left:2px solid rgba(255,255,255,0.32)}
  .hud-corner.tr{top:8px;right:8px;border-top:2px solid rgba(255,255,255,0.32);border-right:2px solid rgba(255,255,255,0.32)}
  .hud-corner.bl{bottom:8px;left:8px;border-bottom:2px solid rgba(255,255,255,0.32);border-left:2px solid rgba(255,255,255,0.32)}
  .hud-corner.br{bottom:8px;right:8px;border-bottom:2px solid rgba(255,255,255,0.32);border-right:2px solid rgba(255,255,255,0.32)}
  .hud-host{position:relative}

  /* Top bar */
  #arena-topbar{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:8px 4px 20px;border-bottom:1px solid rgba(255,255,255,0.08);margin-bottom:20px;flex-wrap:wrap}
  .arena-pill-group{display:flex;gap:8px;flex-wrap:wrap}
  .arena-pill{display:inline-flex;align-items:center;gap:6px;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.14);border-radius:20px;padding:7px 16px;font-family:Orbitron,monospace;font-size:11.5px;letter-spacing:1.5px;color:#9AA5B1;white-space:nowrap}
  .arena-pill b{color:#fff;font-weight:900;margin-left:2px}
  .arena-live-dot{width:6px;height:6px;border-radius:50%;background:#FF4646;animation:livePulse 1.4s infinite}
  .arena-title-wrap{text-align:center;flex:1;min-width:240px}
  #arena-title{font-family:Orbitron,monospace;font-weight:900;font-size:clamp(24px,4vw,34px);letter-spacing:5px;color:#fff;margin:0}
  #arena-subtitle{font-family:"Exo 2",sans-serif;font-size:12px;letter-spacing:3px;color:#6B7684;text-transform:uppercase;margin-top:4px}

  /* Messages banner */
  #sb-messages{max-width:900px;margin:0 auto 20px;text-align:center}
  #sb-msg-line1,#sb-msg-line2{font-size:17px;line-height:1.55;margin:4px 0;color:#C6CDD6}
  #sb-msg-line1{font-weight:700;color:#FFD166}
  #sb-file-meta{text-align:center;font-family:Orbitron,monospace;font-weight:900;font-size:clamp(30px,5vw,46px);letter-spacing:2px;color:#fff;margin:0 auto 22px;text-transform:uppercase;line-height:1.1}

  #ytd-banner{display:flex;justify-content:center;gap:16px;flex-wrap:wrap;max-width:900px;margin:0 auto 22px}
  .ytd-stat{flex:1;min-width:220px;background:rgba(255,255,255,0.035);border:1px solid rgba(255,255,255,0.14);border-radius:14px;padding:14px 20px;text-align:center}
  .ytd-stat-label{font-family:Orbitron,monospace;font-size:10.5px;letter-spacing:2px;color:#8B96A5;text-transform:uppercase;margin-bottom:6px}
  .ytd-stat-value{font-family:Orbitron,monospace;font-size:28px;font-weight:900;color:#fff;line-height:1}
  .ytd-stat-sub{font-family:Orbitron,monospace;font-size:9px;letter-spacing:1px;color:#5B6472;margin-top:6px;text-transform:uppercase}
  body.light-mode .ytd-stat{background:rgba(0,0,0,0.02);border-color:rgba(0,0,0,0.1)}
  body.light-mode .ytd-stat-label,body.light-mode .ytd-stat-sub{color:#94A3B8}
  body.light-mode .ytd-stat-value{color:#0F172A}

  /* Panel grid */
  .arena-row{display:grid;grid-template-columns:1fr 1.15fr 1fr;gap:18px;margin-bottom:18px}
  @media (max-width:980px){.arena-row{grid-template-columns:1fr}}

  .hud-panel{position:relative;background:rgba(255,255,255,0.025);border:1px solid rgba(255,255,255,0.1);border-radius:16px;padding:18px}
  .hud-panel-head{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:14px;padding-bottom:10px;border-bottom:1px solid rgba(255,255,255,0.07)}
  .hud-panel-title{font-family:Orbitron,monospace;font-weight:900;font-size:14.5px;letter-spacing:2px;color:#fff}
  .hud-panel-tag{font-family:Orbitron,monospace;font-size:10px;letter-spacing:2px;color:#5B6472;text-transform:uppercase}

  /* ── Team metrics (left, top row) ── */
  .gauge-wrap{display:flex;justify-content:center;margin:6px 0 16px}
  .gauge{width:128px;height:128px;border-radius:50%;position:relative;background:conic-gradient(#fff calc(var(--pct)*3.6deg), rgba(255,255,255,0.08) 0)}
  .gauge::before{content:"";position:absolute;inset:9px;background:#101318;border-radius:50%}
  .gauge-val{position:absolute;inset:9px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center}
  .gauge-num{font-family:Orbitron,monospace;font-weight:900;font-size:31px;color:#fff;line-height:1}
  .gauge-lbl{font-family:Orbitron,monospace;font-size:10px;letter-spacing:1.5px;color:#7A8492;margin-top:3px}
  .metric-row{margin-bottom:11px}
  .metric-row:last-child{margin-bottom:0}
  .metric-top{display:flex;justify-content:space-between;font-family:Orbitron,monospace;font-size:11px;letter-spacing:1px;color:#8B96A5;margin-bottom:5px}
  .metric-top b{color:#fff;font-size:13px}
  .metric-bar{height:6px;border-radius:4px;background:rgba(255,255,255,0.08);overflow:hidden}
  .metric-bar-fill{height:100%;background:linear-gradient(90deg,#9AA5B1,#fff);border-radius:4px}

  /* ── Top performer core (center, top row) ── */
  #panel-core .hud-panel-head{justify-content:center;gap:24px}
  .core-stat{text-align:center}
  .core-stat-lbl{font-family:Orbitron,monospace;font-size:10px;letter-spacing:2px;color:#5B6472}
  .core-stat-val{font-family:Orbitron,monospace;font-size:15px;font-weight:900;color:#fff;margin-top:2px}
  .core-mid{display:flex;align-items:center;justify-content:space-between;gap:8px}
  .core-side{width:78px;text-align:center;flex-shrink:0}
  .core-side .core-stat-lbl{margin-bottom:6px}
  .core-side .core-stat-val{font-size:23px}
  .minibars{display:flex;align-items:flex-end;gap:3px;height:36px;justify-content:center;margin-top:6px}
