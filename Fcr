<script>
/* ============================================================
   CONFIG — edit these to customize this page
   ============================================================ */
var SCOREBOARD_PW   = "Rbafcr";         // <-- password for THIS page only (separate from the main site)
var AUTH_KEY         = "stp2l_auth";     // sessionStorage key (kept separate from main dashboard's "stp_auth")
var AUTH_TTL_MS      = 8 * 60 * 60 * 1000; // stay logged in 8 hours
var DATA_KEY         = "stp2l_data_v1";  // localStorage key used to remember the CURRENTLY DISPLAYED file — data
                                          // persists here until a new file is uploaded, an older version is picked
                                          // from HISTORY, or "Clear Current View" is clicked
var HISTORY_KEY       = "stp2l_history_v1"; // localStorage key holding the last 10 uploads (independent of DATA_KEY)
var HISTORY_MAX       = 10;

/* ============================================================
   LOGIN / SPLASH
   ============================================================ */
function showPwField(){
  document.getElementById('stp-enter-btn').style.display = 'none';
  var wrap = document.getElementById('stp-pw-wrap');
  wrap.style.display = 'flex';
  setTimeout(function(){ document.getElementById('stp-pw-input').focus(); }, 50);
}

function checkPw(){
  var inp = document.getElementById('stp-pw-input');
  var err = document.getElementById('stp-pw-err');
  var val = inp.value.trim();
  if (val === SCOREBOARD_PW){
    err.style.display = 'none';
    storeAuth();
    enterApp();
  } else {
    err.style.display = 'block';
    inp.value = '';
    inp.style.borderColor = 'rgba(255,68,68,0.6)';
    setTimeout(function(){ inp.style.borderColor = 'rgba(0,212,255,0.25)'; }, 1200);
    inp.focus();
  }
}

function checkStoredAuth(){
  try{
    var raw = sessionStorage.getItem(AUTH_KEY);
    if (!raw) return false;
    var data = JSON.parse(raw);
    if (Date.now() - data.ts > AUTH_TTL_MS){ sessionStorage.removeItem(AUTH_KEY); return false; }
    return true;
  }catch(e){ return false; }
}
function storeAuth(){
  try{ sessionStorage.setItem(AUTH_KEY, JSON.stringify({ts: Date.now()})); }catch(e){}
}

function enterApp(){
  var btn = document.getElementById('stp-enter-btn');
  var wrap = document.getElementById('stp-pw-wrap');
  var ring = document.getElementById('stp-loading-ring');
  var txt  = document.getElementById('stp-loading-text');
  if (btn) btn.style.display = 'none';
  if (wrap) wrap.style.display = 'none';
  if (ring) ring.style.display = 'block';
  if (txt) txt.style.display = 'block';

  setTimeout(function(){
    revealApp();
  }, 500);
}

function revealApp(){
  var lo = document.getElementById('loading-overlay');
  lo.classList.add('fade-out');
  setTimeout(function(){ lo.style.display = 'none'; }, 650);
  document.getElementById('stp-nav').classList.add('stp-nav-visible');
  document.getElementById('app').classList.add('visible');
  addHudCorners();
  tryLoadSavedData();
  populateHistoryMenu();
}

function signOut(){
  try{ sessionStorage.removeItem(AUTH_KEY); }catch(e){}
  location.reload();
}

(function(){
  if (checkStoredAuth()){
    document.getElementById('stp-enter-btn').style.display = 'none';
    document.getElementById('stp-loading-ring').style.display = 'block';
    document.getElementById('stp-loading-text').style.display = 'block';
    setTimeout(revealApp, 500);
  }
})();

/* ============================================================
   NAV DROPDOWN
   ============================================================ */
function toggleDropdown(btn){
  var menu = btn.nextElementSibling;
  var open = menu.classList.contains('open');
  document.querySelectorAll('.stp-drop-menu.open').forEach(function(m){ m.classList.remove('open'); });
  if (!open) menu.classList.add('open');
}
document.addEventListener('click', function(e){
  if (!e.target.closest('.stp-dropdown')) {
    document.querySelectorAll('.stp-drop-menu.open').forEach(function(m){ m.classList.remove('open'); });
  }
});

function toggleLightMode(){
  document.body.classList.toggle('light-mode');
  try{ localStorage.setItem('stp2l_light', document.body.classList.contains('light-mode') ? '1':'0'); }catch(e){}
}
(function(){
  try{ if (localStorage.getItem('stp2l_light')==='1') document.body.classList.add('light-mode'); }catch(e){}
})();

/* Decorative HUD corner brackets, added to every panel + the main board */
function addHudCorners(){
  document.querySelectorAll('.hud-panel, #arena-board').forEach(function(el){
    if (el.dataset.huddone) return;
    el.dataset.huddone = '1';
    el.classList.add('hud-host');
    ['tl','tr','bl','br'].forEach(function(pos){
      var s = document.createElement('span');
      s.className = 'hud-corner ' + pos;
      el.appendChild(s);
    });
  });
}

/* ============================================================
   FILE HANDLING (drag/drop + click-to-browse)
   ============================================================ */
var emptyEl = document.getElementById('sb-empty');
['dragenter','dragover'].forEach(function(evt){
  emptyEl.addEventListener(evt, function(e){ e.preventDefault(); emptyEl.classList.add('dragover'); });
});
['dragleave','drop'].forEach(function(evt){
  emptyEl.addEventListener(evt, function(e){ e.preventDefault(); emptyEl.classList.remove('dragover'); });
});
emptyEl.addEventListener('drop', function(e){
  var f = e.dataTransfer.files && e.dataTransfer.files[0];
  if (f) processFile(f);
});

function handleFileSelect(e){
  var f = e.target.files && e.target.files[0];
  if (f) processFile(f);
  e.target.value = '';
}

function processFile(file){
  var errEl = document.getElementById('sb-file-error');
  errEl.style.display = 'none';
  var reader = new FileReader();
  reader.onload = function(e){
    try{
      var wb = XLSX.read(e.target.result, {type:'array', cellDates:true});
      var data = parseWorkbook(wb);
      data.fileName = file.name;
      data.loadedAt = Date.now();
      data.histId = 'h' + Date.now() + '_' + Math.random().toString(36).slice(2,7);
      // Overwriting DATA_KEY here is the ONLY thing that replaces the CURRENT VIEW —
      // it stays exactly as-is across refreshes/closes until a new file comes in
      // (or an older version is picked from the History menu).
      try{ localStorage.setItem(DATA_KEY, JSON.stringify(data)); }catch(err){}
      saveToHistory(data);
      renderScoreboard(data);
    }catch(err){
      console.error(err);
      errEl.textContent = err.message || 'Could not read that file. Please double check it\'s the 2nd Look Reporting workbook.';
      errEl.style.display = 'block';
    }
  };
  reader.onerror = function(){
    errEl.textContent = 'Could not read that file.';
    errEl.style.display = 'block';
  };
  reader.readAsArrayBuffer(file);
}

function tryLoadSavedData(){
  try{
    var raw = localStorage.getItem(DATA_KEY);
    if (raw){ renderScoreboard(JSON.parse(raw)); }
  }catch(e){}
}

function clearScoreboardData(){
  try{ localStorage.removeItem(DATA_KEY); }catch(e){}
  document.getElementById('sb-content').style.display = 'none';
  document.getElementById('sb-empty').style.display = 'block';
  populateHistoryMenu();
}

/* ============================================================
   UPLOAD HISTORY — keeps the last 10 files that were uploaded so
   an older version can be reloaded from the nav at any time.
   This list is separate from DATA_KEY (the "currently displayed" file):
   uploading a new file always adds to history, but switching between
   history entries never removes anything from the list.
   ============================================================ */
function getHistory(){
  try{
    var raw = localStorage.getItem(HISTORY_KEY);
    return raw ? JSON.parse(raw) : [];
  }catch(e){ return []; }
}

function saveToHistory(data){
  var hist = getHistory();
  hist.unshift(data);              // newest first
  if (hist.length > HISTORY_MAX) hist = hist.slice(0, HISTORY_MAX);
  try{ localStorage.setItem(HISTORY_KEY, JSON.stringify(hist)); }catch(e){}
  populateHistoryMenu();
}

function loadHistoryEntry(histId){
  var hist = getHistory();
  var entry = hist.find(function(h){ return h.histId === histId; });
  if (!entry) return;
  try{ localStorage.setItem(DATA_KEY, JSON.stringify(entry)); }catch(e){}
  renderScoreboard(entry);
  populateHistoryMenu();
  document.querySelectorAll('.stp-drop-menu.open').forEach(function(m){ m.classList.remove('open'); });
}

function clearScoreboardHistory(){
  try{ localStorage.removeItem(HISTORY_KEY); }catch(e){}
  populateHistoryMenu();
}

function populateHistoryMenu(){
  var listEl = document.getElementById('stp-history-list');
  if (!listEl) return;
  var hist = getHistory();
  var activeId = null;
  try{
    var cur = localStorage.getItem(DATA_KEY);
    if (cur) activeId = JSON.parse(cur).histId;
  }catch(e){}

  if (!hist.length){
    listEl.innerHTML = '<div class="hist-empty">No uploads yet — upload a file to start building history.</div>';
    return;
  }
  var html = '';
  hist.forEach(function(entry){
    var isActive = entry.histId === activeId;
    var dateLabel = entry.reportDate ? fmtDateShort(entry.reportDate) : 'Undated';
    var whenLabel = entry.loadedAt ? new Intl.DateTimeFormat('en-US',{month:'short',day:'numeric',hour:'numeric',minute:'2-digit'}).format(new Date(entry.loadedAt)) : '';
    html += '<button class="hist-item' + (isActive?' active':'') + '" onclick="loadHistoryEntry(\'' + entry.histId + '\')">' +
      '<span class="hist-item-check">' + (isActive?'●':'') + '</span>' +
      '<span class="hist-item-body">' +
        '<span class="hist-item-date">' + escapeHtml(dateLabel) + '</span>' +
        '<span class="hist-item-meta">' + escapeHtml(entry.fileName || 'file') + ' &middot; uploaded ' + whenLabel + '</span>' +
      '</span>' +
      '</button>';
  });
  listEl.innerHTML = html;
}

/* ============================================================
   PARSING — reads the "Calculator" style table out of the workbook.
   Looks for a row whose first cell is "Analyst" to locate the table,
   so it still works if the sheet name or row position changes.
   ============================================================ */
function norm(v){ return (v===null||v===undefined) ? '' : String(v).trim().toLowerCase(); }
function num(v){
  if (v===null || v===undefined || v==='') return null;
  if (typeof v === 'number') return v;
  var n = parseFloat(String(v).replace(/[^0-9.\-]/g,''));
  return isNaN(n) ? null : n;
}

function parseWorkbook(wb){
  var rows = null, sheetName = null, headerIdx = -1;
  for (var s=0; s<wb.SheetNames.length; s++){
    var name = wb.SheetNames[s];
    var r = XLSX.utils.sheet_to_json(wb.Sheets[name], {header:1, raw:true, defval:null});
    var idx = r.findIndex(function(row){ return row && norm(row[0]) === 'analyst'; });
    if (idx > -1){ rows = r; sheetName = name; headerIdx = idx; break; }
  }
  if (!rows) throw new Error('Could not find an "Analyst" table in this workbook. Make sure the Calculator/2nd Look tab is included.');

  var reportDate = null;
  var dateRow = rows[headerIdx-1];
  if (dateRow && dateRow[0]){
    var dv = dateRow[0];
    reportDate = (dv instanceof Date) ? dv : new Date(dv);
    if (isNaN(reportDate.getTime())) reportDate = null;
  }

  var analysts = [];
  var i = headerIdx + 1;
  while (i < rows.length && rows[i] && norm(rows[i][0]) !== ''){
    var r2 = rows[i];
    analysts.push({
      name: String(r2[0]).trim(),
      approvalPct: num(r2[1]), pullPct: num(r2[2]),
      booked: num(r2[3]), bookedApps: num(r2[4]),
      approved: num(r2[5]), approvedApps: num(r2[6]),
      reviewed: num(r2[7]), reviewedApps: num(r2[8])
    });
    i++;
  }
  var totals = null;
  if (rows[i]){
    var tr = rows[i];
    totals = {
      approvalPct: num(tr[1]), pullPct: num(tr[2]),
      booked: num(tr[3]), bookedApps: num(tr[4]),
      approved: num(tr[5]), approvedApps: num(tr[6]),
      reviewed: num(tr[7]), reviewedApps: num(tr[8])
    };
    i++;
  }

  var yesterday = [], yesterdayTotal = null;
  var ybIdx = -1;
  for (var j=i; j<rows.length && j<i+40; j++){
    if (rows[j] && norm(rows[j][0]).indexOf('dollars booked yesterday') === 0){ ybIdx = j; break; }
  }
  var afterYesterdayIdx = i;
  if (ybIdx > -1){
    var k = ybIdx + 2;
    while (k < rows.length && rows[k] && norm(rows[k][0]) !== '' && norm(rows[k][0]).indexOf('dollars booked') !== 0){
      var yr = rows[k];
      yesterday.push({ name: String(yr[0]).trim(), booked: num(yr[1]), apps: num(yr[2]) });
      k++;
    }
    if (rows[k] && norm(rows[k][0]).indexOf('dollars booked') === 0){
      yesterdayTotal = { booked: num(rows[k][1]), apps: num(rows[k][2]) };
      k++;
    }
    afterYesterdayIdx = k;
  }

  var pace = {};
  var paceIdx = -1;
  for (var m=afterYesterdayIdx; m<rows.length; m++){
    if (rows[m] && norm(rows[m][0]).indexOf('pace report') === 0){ paceIdx = m; break; }
  }
  if (paceIdx > -1){
    for (var p=paceIdx+1; p<rows.length && p<paceIdx+8; p++){
      var lab = rows[p] ? norm(rows[p][0]) : '';
      if (!lab) break;
      var val = rows[p][1];
      if (lab.indexOf('august goal') > -1 || (lab.indexOf('goal') > -1 && lab.indexOf('daily') === -1)) pace.goal = val;
      else if (lab.indexOf('mtd $') > -1 || lab.indexOf('mtd booked') > -1 || (lab.indexOf('mtd') > -1 && lab.indexOf('booked') > -1)) pace.mtdBooked = val;
      else if (lab.indexOf('mtd pace %') > -1) pace.pacePct = val;
      else if (lab.indexOf('mtd pace $') > -1) pace.paceDollar = val;
      else if (lab.indexOf('daily goal') > -1) pace.dailyGoal = val;
    }
  }

  return { sheetName: sheetName, reportDate: reportDate ? reportDate.toISOString() : null,
           analysts: analysts, totals: totals, yesterday: yesterday, yesterdayTotal: yesterdayTotal, pace: pace,
           allQuarters: parseAllQuarters(wb) };
}

/* ============================================================
   "ALL QUARTERS" TAB — YTD Pull Through Rate & Total Booked (Year),
   plus a full per-market/per-quarter breakdown for the drill-down
   popups. Walks each "Q# Second Look Results" block, grabs the
   6-market row (NY/NJ Metro, Long Island, Georgia, San Francisco,
   MidWest, Fairchester) plus the sheet's own Totals column (index 7),
   for: Total Apps, Total Booked (count), Approval %, Pull Through %,
   and Booked $ (from the Totals-by-$ section). YTD figures are summed
   across every quarter found, so this adapts automatically as more
   quarters fill in.
   ============================================================ */
function parseAllQuarters(wb){
  var sheetName = null, ws = null;
  for (var i=0; i<wb.SheetNames.length; i++){
    if (norm(wb.SheetNames[i]).indexOf('all quarters') > -1){ sheetName = wb.SheetNames[i]; ws = wb.Sheets[sheetName]; break; }
  }
  if (!ws) return null;

  var rows = XLSX.utils.sheet_to_json(ws, {header:1, raw:true, defval:null});
  var quarters = [];
  var current = null;

  for (var r=0; r<rows.length; r++){
    var row = rows[r];
    if (!row) continue;
    var cell0 = (row[0] !== null && row[0] !== undefined) ? String(row[0]).trim() : '';
    var qMatch = cell0.match(/^Q(\d+)\b.*second look results/i);
    if (qMatch){
      if (current) quarters.push(current);
      current = { label: 'Q' + qMatch[1], regions: null, apps: null, bookedCount: null, approvalPct: null, pullThroughPct: null, bookedDollar: null };
      continue;
    }
    if (!current) continue;

    // Region header: 6 consecutive text cells in columns 1-6 (appears blank-labeled, and again
    // on the "Key Metrics:" / "Totals (Volume by $):" rows — first occurrence is enough).
    if (!current.regions){
      var candidates = row.slice(1,7);
      if (candidates.length === 6 && candidates.every(function(c){ return typeof c === 'string' && c.trim() !== ''; })){
        current.regions = candidates.map(function(c){ return c.trim(); });
        continue;
      }
    }

    var lab = norm(cell0).replace(/:\s*$/,'').trim();
    var vals = row.slice(1,8).map(num); // 6 markets + the sheet's own Totals column (7 values)
    if (lab === 'total apps' || lab === 'total applications') current.apps = vals;
    else if (lab === 'total booked') current.bookedCount = vals;
    else if (lab === 'approval %') current.approvalPct = vals;
    else if (lab === 'pull through %') current.pullThroughPct = vals;
    else if (lab === 'booked') current.bookedDollar = vals;
  }
  if (current) quarters.push(current);
  if (!quarters.length) return null;

  var appsTotal = 0, bookedCountTotal = 0, bookedDollarTotal = 0;
  quarters.forEach(function(q){
    if (q.apps && q.apps[6] !== null) appsTotal += q.apps[6];
    if (q.bookedCount && q.bookedCount[6] !== null) bookedCountTotal += q.bookedCount[6];
    if (q.bookedDollar && q.bookedDollar[6] !== null) bookedDollarTotal += q.bookedDollar[6];
  });

  return {
    sheetName: sheetName,
    quarters: quarters,
    ytdApps: appsTotal,
    ytdBookedCount: bookedCountTotal,
    ytdBookedDollars: bookedDollarTotal,
    ytdPullThroughRate: appsTotal ? (bookedCountTotal / appsTotal) : null
  };
}

/* ============================================================
   FORMATTING HELPERS
   ============================================================ */
function fmtMoney(n){
  if (n === null || n === undefined || isNaN(n)) return '—';
  return '$' + Number(n).toLocaleString('en-US',{minimumFractionDigits:0,maximumFractionDigits:0});
}
function fmtMoneyShort(n){
  if (n === null || n === undefined || isNaN(n)) return '—';
  n = Number(n);
  if (Math.abs(n) >= 1000000) return '$' + (n/1000000).toFixed(2) + 'M';
  if (Math.abs(n) >= 1000) return '$' + Math.round(n/1000) + 'K';
  return '$' + Math.round(n);
}
function fmtInt(n){
  if (n === null || n === undefined || isNaN(n)) return '—';
  return Number(n).toLocaleString('en-US');
}
function fmtPct(n, decimals){
  if (n === null || n === undefined || isNaN(n)) return '—';
  return (n*100).toFixed(decimals===undefined?1:decimals) + '%';
}
function fmtDate(iso){
  if (!iso) return '';
  var d = new Date(iso);
  if (isNaN(d.getTime())) return '';
  return new Intl.DateTimeFormat('en-US',{weekday:'long', month:'long', day:'numeric', year:'numeric'}).format(d);
}
function fmtDateShort(iso){
  if (!iso) return '—';
  var d = new Date(iso);
  if (isNaN(d.getTime())) return '—';
  return new Intl.DateTimeFormat('en-US',{month:'short', day:'numeric'}).format(d);
}
function escapeHtml(s){
  return String(s).replace(/[&<>"']/g, function(c){
    return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];
  });
}

/* ============================================================
   MESSAGE GENERATION — mirrors the "shout out" style banner
   ============================================================ */
function buildMessages(data){
  var big = (data.yesterday || []).filter(function(a){ return a.booked !== null && a.booked >= 100000; });
  var line1;
  if (big.length){
    var names = big.map(function(a){ return a.name; });
    var joined = names.length === 1 ? names[0]
      : names.length === 2 ? names.join(' and ')
      : names.slice(0,-1).join(', ') + ' and ' + names[names.length-1];
    line1 = '🎉 We had a BIG day yesterday! Shout out to ' + joined + ' for booking over $100k' + (names.length>1?' each':'') + '!';
  } else if (data.yesterdayTotal && data.yesterdayTotal.booked){
    line1 = '💪 Nice work yesterday — the team booked ' + fmtMoney(data.yesterdayTotal.booked) + ' across ' + fmtInt(data.yesterdayTotal.apps) + ' apps.';
  } else {
    line1 = '📈 Let\'s get the board moving today!';
  }

  var line2 = '';
  if (data.totals && data.totals.approvalPct !== null && data.totals.pullPct !== null){
    var ap = data.totals.approvalPct, pt = data.totals.pullPct;
    if (ap - pt > 0.2){
      line2 = 'Approval % is at ' + fmtPct(ap) + ' — let\'s close the gap on Pull Through, which is at ' + fmtPct(pt) + '.';
    } else {
      line2 = 'Approval % is at ' + fmtPct(ap) + ' and Pull Through isn\'t too far behind at ' + fmtPct(pt) + '. Let\'s keep these numbers up all month.';
    }
  }
  return [line1, line2];
}

